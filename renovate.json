{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>victron-venus/venus-os-ci-toolkit:renovate-fleet"
  ],
  "enabledManagers": [
    "custom.jsonata",
    "custom.regex",
    "github-actions",
    "pip-compile",
    "pip_requirements"
  ],
  "ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/fixtures/**",
    "**/tools/browser-compatibility/**",
    "security/provider/**",
    "build-support/tls-armv7/**"
  ],
  "packageRules": [
    {
      "description": "The native compiler owns both manifests and regenerates runtime first, then the constrained development lock.",
      "matchManagers": [
        "pip-compile"
      ],
      "matchFileNames": [
        "requirements.txt",
        "requirements-dev.txt"
      ],
      "groupName": "Application dependencies",
      "groupSlug": "application-dependencies",
      "groupSingleUpdates": true,
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "separateMultipleMajor": false
    },
    {
      "description": "Preserve the explicitly named legacy Bandit 1.9.2 toolchain while allowing its transitive lock maintenance.",
      "matchManagers": [
        "pip-compile"
      ],
      "matchFileNames": [
        ".github/requirements-bandit-1.9.2.in"
      ],
      "matchPackageNames": [
        "bandit"
      ],
      "allowedVersions": "==1.9.2"
    }
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)requirements[^/]*\\.(txt|pip)$/"
    ],
    "ignorePaths": [
      "**/vendor/**",
      "**/node_modules/**",
      "**/fixtures/**",
      "**/tools/browser-compatibility/**",
      "security/provider/**",
      "build-support/tls-armv7/**",
      ".github/requirements-bandit-1.9.2.txt",
      ".github/requirements-fuzz.txt",
      "requirements.lock",
      "requirements-dev.lock",
      "requirements.txt",
      "requirements-dev.txt"
    ]
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/^requirements\\.lock$/",
      "/^requirements\\-dev\\.lock$/",
      "/^\\.github/requirements\\-bandit\\-1\\.9\\.2\\.txt$/",
      "/^\\.github/requirements\\-fuzz\\.txt$/"
    ]
  }
}
