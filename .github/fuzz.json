{
  "schema": 1,
  "language": "python",
  "setup": [
    [
      "python3",
      "-m",
      "venv",
      ".fuzz-venv"
    ],
    [
      ".fuzz-venv/bin/python",
      "-m",
      "pip",
      "install",
      "--require-hashes",
      "--only-binary=:all:",
      "-r",
      ".github/requirements-fuzz.txt"
    ]
  ],
  "targets": [
    {
      "name": "ha",
      "engine": "atheris",
      "command": [
        ".fuzz-venv/bin/python",
        "fuzz/fuzz_ha.py",
        "-max_len=4096"
      ],
      "seconds": 60,
      "corpus": "fuzz/corpus/ha",
      "instrumentation": [
        {
          "module": "parse_ha",
          "functions": [
            "parse_ha_state_change",
            "parse_submeter_state",
            "parse_power"
          ]
        }
      ]
    }
  ],
  "preflight-paths": [
    ".github/requirements-fuzz.in",
    "fuzz",
    "parse_ha.py",
    "requirements-dev.lock",
    "requirements-dev.txt",
    "requirements.lock",
    "requirements.txt"
  ]
}
